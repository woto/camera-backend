<!DOCTYPE html>
<html>
  <head>
    <title id="page-title"><%= content_for(:title) || "Volley Cam" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-screen overflow-hidden relative selection:bg-accent-purple/30 selection:text-white bg-bg">
    <div class="flex h-screen w-screen relative z-10 overflow-hidden" data-controller="sidebar">
      <!-- Overlay for mobile sidebar -->
      <div class="fixed inset-0 bg-black/80 z-40 hidden"
           data-sidebar-target="overlay"
           data-action="click->sidebar#close"></div>

      <aside class="fixed inset-y-0 left-0 z-50 w-72 bg-sidebar-bg border-r border-white/5 flex flex-col shrink-0 transform -translate-x-full lg:relative lg:translate-x-0"
             data-sidebar-target="aside">
        <div class="p-10 relative z-10 lg:block hidden">
          <%= link_to events_path, class: "flex items-center gap-4 group" do %>
            <div class="w-12 h-12 flex items-center justify-center">
              <%= render "layouts/logo_icon" %>
            </div>
            <span class="text-3xl font-black tracking-tight text-white group-hover:text-white/90">VolleyCam</span>
          <% end %>
        </div>

        <!-- Mobile Sidebar Close Button -->
        <div class="lg:hidden p-6 flex justify-between items-center border-b border-white/5">
          <%= link_to events_path, class: "flex items-center gap-3 group" do %>
             <div class="w-8 h-8 flex items-center justify-center">
               <%= render "layouts/logo_icon" %>
             </div>
             <span class="text-xl font-black text-white group-hover:text-white/90">VolleyCam</span>
          <% end %>
          <button data-action="click->sidebar#close" class="text-text-secondary hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <nav class="flex-grow lg:py-0 relative z-10 overflow-y-auto custom-scrollbar">
          <div class="px-6 py-6">
            <%= render "layouts/nav" %>
          </div>
          <div class="pointer-events-none sticky bottom-0 h-10 bg-gradient-to-b from-transparent to-sidebar-bg"></div>
        </nav>
        <div class="px-6 pb-4 space-y-3">
          <%= render "layouts/locale_dropdown" %>
          <div class="flex items-center justify-between gap-4 px-5 py-3.5 rounded-2xl font-black text-text-secondary bg-accent-blue/10 border border-accent-blue/30">
            <div class="flex items-center gap-4">
              <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-text-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4"/><path d="M15 6h4a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-4"/><path d="M8 12h8"/></svg>
              </div>
              <span class="text-[13px] tracking-tight"><%= t("nav.cameras_online") %></span>
            </div>
            <span class="text-[11px] font-black uppercase tracking-[0.2em] text-white/70" data-ws-connections-count><%= websocket_connections_count %></span>
          </div>
        </div>
        <footer class="px-6 py-4 border-t border-white/5 text-xs text-text-secondary">
          <%= link_to t("nav.privacy_policy"), policy_path, class: "hover:text-white underline" %>
        </footer>
      </aside>

      <div class="flex-grow flex flex-col overflow-hidden relative">
        <!-- Mobile Header Toggle -->
        <div class="lg:hidden flex items-center justify-between px-6 py-4 bg-sidebar-bg border-b border-white/5 z-30 shrink-0">
          <%= link_to events_path, class: "flex items-center gap-3 group" do %>
             <div class="w-8 h-8 flex items-center justify-center">
               <%= render "layouts/logo_icon" %>
             </div>
             <span class="text-xl font-black text-white group-hover:text-white/90">VolleyCam</span>
          <% end %>
          <button data-action="click->sidebar#toggle" class="p-2 text-text-secondary hover:text-white bg-white/5 rounded-xl border border-white/5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
            </svg>
          </button>
        </div>

        <div id="flash" class="px-6 md:px-10 pt-6 relative z-30">
          <%= render "layouts/flash" %>
        </div>
        <main id="page_body" class="flex-grow overflow-y-auto px-4 md:px-10 pt-8 md:pt-16 pb-20 custom-scrollbar relative z-10">
          <%= yield %>
        </main>
      </div>
    </div>

    <turbo-frame id="modal"></turbo-frame>
  </body>
</html>
