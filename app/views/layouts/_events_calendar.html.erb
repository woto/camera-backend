<div class="px-6 pb-6"
     data-controller="events-calendar"
     data-events-calendar-dates-value="<%= ERB::Util.json_escape(event_dates.map(&:iso8601).to_json) %>"
     data-events-calendar-selected-value="<%= params[:date] %>"
     data-events-calendar-base-url-value="<%= events_path(room: params[:room]) %>"
     data-events-calendar-months-value="<%= ERB::Util.json_escape(I18n.t('date.month_names').drop(1).to_json) %>"
     data-events-calendar-empty-label-value="<%= t('calendar.empty') %>">
  <div class="flex items-center justify-between">
    <div class="text-[10px] font-black uppercase tracking-widest text-text-secondary"><%= t("calendar.title") %></div>
    <div class="flex items-center gap-2">
      <button type="button" data-action="events-calendar#prev" class="w-7 h-7 rounded-lg bg-white/5 text-text-secondary hover:text-white hover:bg-white/10 border border-white/5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mx-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button type="button" data-action="events-calendar#next" class="w-7 h-7 rounded-lg bg-white/5 text-text-secondary hover:text-white hover:bg-white/10 border border-white/5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mx-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
  <div class="mt-3 text-sm font-black text-white" data-events-calendar-target="monthLabel"></div>
  <div class="mt-3 grid grid-cols-7 gap-1 text-[10px] text-text-secondary uppercase tracking-wider">
    <% abbr_days = I18n.t("date.abbr_day_names") %>
    <% ordered_days = abbr_days.drop(1) + abbr_days.first(1) %>
    <% ordered_days.each do |day| %>
      <div class="text-center"><%= day %></div>
    <% end %>
  </div>
  <div class="mt-2 grid grid-cols-7 gap-1" data-events-calendar-target="grid"></div>
  <div class="mt-3 text-xs text-text-secondary/70" data-events-calendar-target="empty"></div>
</div>
