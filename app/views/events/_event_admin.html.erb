<div id="event-admin">
  <% if current_user && @captures.any? %>
    <div class="mt-20 pt-10 border-t border-border-dim">
      <h2 class="text-xl font-bold text-white mb-6"><%= t("admin.title") %></h2>
        <div class="mb-6">
          <%= button_to t("admin.generate_hls_all"), generate_hls_all_event_path(@event), method: :post, class: "btn-ghost text-sm py-2" %>
        </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <div>
          <h3 class="text-sm uppercase tracking-widest font-black text-zinc-600 mb-4"><%= t("admin.sync.title") %></h3>
          <div class="flex flex-wrap gap-2 mb-6">
            <% @captures.each do |capture| %>
              <%= button_to t("admin.sync.set_base", id: capture.id), set_base_event_path(@event, capture_id: capture.id), method: :post, class: "btn-ghost text-xs py-1" %>
            <% end %>
          </div>
          <div class="space-y-2 mb-6">
            <% @captures.each do |capture| %>
              <div class="flex items-center justify-between bg-zinc-900/50 p-3 rounded-xl border border-border-dim">
                <div class="text-[11px] font-bold text-zinc-500 uppercase tracking-wider">
                  <%= t("events.files.capture", id: capture.id) %>
                </div>
                <div class="flex items-center gap-2 text-[11px] font-bold text-white/70">
                  <% if capture.id == @base_capture&.id %>
                    <span class="badge badge-open text-[9px] px-2 py-0.5"><%= t("admin.sync.base") %></span>
                  <% end %>
                  <span><%= t("admin.sync.offset") %>: <%= capture.offset_seconds.nil? ? t("admin.sync.offset_none") : "#{number_with_precision(capture.offset_seconds.to_f, precision: 3)}s" %></span>
                </div>
              </div>
            <% end %>
          </div>

          <%= form_with url: sync_offsets_event_path(@event), method: :post, local: true, class: "space-y-4" do |f| %>
            <div class="grid grid-cols-1 gap-4">
              <div class="flex flex-col gap-1.5">
                <label class="text-[11px] font-bold text-zinc-500 uppercase tracking-wider"><%= t("admin.sync.base_capture") %></label>
                <%= select_tag :capture_id, options_from_collection_for_select(@captures, :id, :id, @base_capture&.id), class: "bg-sidebar-active border border-border-dim text-white rounded-lg p-2 text-sm outline-none focus:border-accent-purple" %>
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[11px] font-bold text-zinc-500 uppercase tracking-wider"><%= t("admin.sync.analyze_duration") %></label>
                <%= number_field_tag :analyze_duration, 90, class: "bg-sidebar-active border border-border-dim text-white rounded-lg p-2 text-sm outline-none focus:border-accent-purple" %>
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[11px] font-bold text-zinc-500 uppercase tracking-wider"><%= t("admin.sync.sample_rate") %></label>
                <%= number_field_tag :sample_rate, 8000, class: "bg-sidebar-active border border-border-dim text-white rounded-lg p-2 text-sm outline-none focus:border-accent-purple" %>
              </div>
            </div>
            <%= f.submit t("admin.sync.submit"), class: "btn-primary w-full text-xs" %>
          <% end %>
        </div>

        <div>
          <h3 class="text-sm uppercase tracking-widest font-black text-zinc-600 mb-4"><%= t("admin.hls.title") %></h3>
          <div class="space-y-4">
            <% @captures.each do |capture| %>
              <div class="bg-zinc-900/50 p-4 rounded-xl border border-border-dim">
                <div class="text-[11px] font-bold text-zinc-500 uppercase tracking-wider mb-3">
                  <%= t("events.files.capture", id: capture.id) %>
                </div>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                  <% if capture.hls_manifest_path.present? %>
                    <span class="text-[11px] text-green-400"><%= t("admin.hls.ready") %></span>
                    <%= link_to capture.hls_manifest_path, capture.hls_manifest_path, class: "text-[11px] underline text-white/80", target: "_blank", rel: "noopener" %>
                    <%= button_to t("admin.hls.regenerate"), generate_hls_event_path(@event, capture_id: capture.id), method: :post, class: "btn-ghost text-xs py-1" %>
                  <% elsif capture.hls_processing? %>
                    <span class="text-[11px] text-yellow-300"><%= t("admin.hls.processing") %></span>
                    <%= button_to t("admin.hls.refresh"), event_path(@event), method: :get, class: "btn-ghost text-xs py-1" %>
                  <% else %>
                    <%= button_to t("admin.hls.generate"), generate_hls_event_path(@event, capture_id: capture.id), method: :post, class: "btn-ghost text-xs py-1" %>
                  <% end %>
                  <% if capture.hls_error.present? %>
                    <div class="text-[11px] text-red-400 ml-2"><%= t("admin.hls.error") %>: <%= capture.hls_error %></div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
