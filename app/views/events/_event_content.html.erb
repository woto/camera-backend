<div id="event-shell" class="max-w-5xl mx-auto" data-controller="video-switcher"
     data-video-switcher-captures-value="<%= @switcher_captures.to_json %>"
     data-video-switcher-current-id-value="<%= @base_capture&.id %>"
     data-video-switcher-prev-event-url-value="<%= @prev_event ? event_path(@prev_event, room: current_room_name) : "" %>"
     data-video-switcher-next-event-url-value="<%= @next_event ? event_path(@next_event, room: current_room_name) : "" %>">
  <%= render "event_switcher_data" %>
  <%= render "event_header" %>
  <%= render "event_title" %>

  <% if @captures.any? %>
    <div class="p-0 md:p-1.5 mb-8 md:mb-12 relative overflow-visible group/player -mx-4 md:mx-0 md:bg-card-bg md:bg-white/[0.02] md:border md:border-border-dim md:rounded-2xl md:overflow-hidden">
      <div class="p-0 md:p-4 pt-0">
        <div id="event-player" class="player-container group/player rounded-none md:!rounded-[2rem] select-none" data-turbo-permanent
             data-action="mousemove->video-switcher#showControls touchstart->video-switcher#showControls mouseenter->video-switcher#showControls pointerdown->video-switcher#startSpeedBoost pointerup->video-switcher#stopSpeedBoost pointercancel->video-switcher#stopSpeedBoost pointerleave->video-switcher#stopSpeedBoost pointermove->video-switcher#updateSpeedBoost">
          <%= link_to(@next_event ? event_path(@next_event) : "#",
            class: "player-nav absolute left-3 md:left-4 top-1/2 -translate-y-1/2 z-30 w-9 h-9 md:w-11 md:h-11 bg-white/10 rounded-full border border-white/10 flex items-center justify-center text-white/80 hover:text-white hover:bg-white/20 transition-all",
            title: t("events.navigation.newer"),
            data: { turbo: "false", action: "video-switcher#navigateEvent", video_switcher_target: "nextEventLink" }) do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 md:w-5 md:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          <% end %>
          <%= link_to(@prev_event ? event_path(@prev_event) : "#",
            class: "player-nav absolute right-3 md:right-4 top-1/2 -translate-y-1/2 z-30 w-9 h-9 md:w-11 md:h-11 bg-white/10 rounded-full border border-white/10 flex items-center justify-center text-white/80 hover:text-white hover:bg-white/20 transition-all",
            title: t("events.navigation.older"),
            data: { turbo: "false", action: "video-switcher#navigateEvent", video_switcher_target: "prevEventLink" }) do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 md:w-5 md:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          <% end %>
          <%= video_tag "",
            preload: "metadata",
            class: "player-video",
            playsinline: true,
            webkitplaysinline: true,
            crossorigin: "anonymous",
            data: {
              video_switcher_target: "player",
              action: "click->video-switcher#togglePlay dblclick->video-switcher#toggleFullscreen timeupdate->video-switcher#updateProgress loadedmetadata->video-switcher#onLoadedMetadata play->video-switcher#onPlay pause->video-switcher#onPause volumechange->video-switcher#onVolumeChange"
            } %>

          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-30 px-6 py-4 rounded-full bg-black/70 border border-white/10 text-4xl md:text-6xl font-black tracking-widest text-white opacity-0 invisible transition-all duration-200 pointer-events-none"
               data-video-switcher-target="speedBadge">
            <span data-video-switcher-target="speedBadgeValue">2.00x</span>
          </div>

          <%= render "event_overlay" %>

          <div class="absolute inset-0 z-20 flex flex-col justify-end opacity-0 invisible transition-all duration-300 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"
               data-video-switcher-target="controlsOverlay"
               data-action="click->video-switcher#togglePlay">
            <div class="player-controls p-4 md:p-8 pointer-events-auto"
                 data-action="click->video-switcher#stopEvent pointerdown->video-switcher#stopEvent pointerup->video-switcher#stopEvent pointermove->video-switcher#stopEvent">
              <!-- Camera Selection -->
              <div class="source-buttons mb-4 !justify-center overflow-x-auto scrollbar-hide flex-nowrap" data-video-switcher-target="controls"></div>

              <!-- Progress -->
              <div class="relative w-full h-1.5 md:h-2 bg-white/10 rounded-full mb-6 cursor-pointer group/progress"
                   data-action="click->video-switcher#onProgressClick mousemove->video-switcher#onProgressHover mouseleave->video-switcher#hidePreview">
                <input type="range" min="0" max="100" value="0" step="0.01"
                  class="absolute inset-x-0 -top-2 -bottom-2 w-full opacity-0 cursor-pointer z-10"
                  data-video-switcher-target="progress"
                  data-action="input->video-switcher#onProgressInput change->video-switcher#onProgressChange">
                <div class="absolute top-0 left-0 h-full bg-accent-purple rounded-full pointer-events-none" 
                  data-video-switcher-target="progressBar" style="width: 0%"></div>
                <div class="absolute top-1/2 -translate-y-1/2 w-3 h-3 md:w-4 md:h-4 bg-white rounded-full shadow-xl opacity-0 group-hover/progress:opacity-100 transition-opacity pointer-events-none"
                  data-video-switcher-target="progressHandle" style="left: 0%"></div>
                <div class="absolute -top-24 left-1/2 -translate-x-1/2 opacity-0 invisible transition-all duration-150 pointer-events-none z-30"
                     data-video-switcher-target="preview">
                  <div class="w-40 bg-black/80 border border-white/10 rounded-lg p-2 shadow-xl">
                    <img class="w-full h-20 object-cover rounded-md" alt="" data-video-switcher-target="previewImage">
                    <div class="mt-1 text-[10px] font-black text-white/70 text-center tracking-widest" data-video-switcher-target="previewTime">00:00</div>
                  </div>
                </div>
              </div>

              <div class="flex items-center justify-between">
                <div class="flex items-center gap-4 md:gap-8">
                  <button type="button" data-action="video-switcher#togglePlay" class="text-white hover:text-accent-purple transition-all transform active:scale-90">
                    <div data-video-switcher-target="playIcon">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 md:w-8 md:h-8" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                    <div data-video-switcher-target="pauseIcon" class="hidden">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 md:w-8 md:h-8" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                    </div>
                  </button>

                  <div class="text-[10px] md:text-xs font-black text-white uppercase tracking-[0.2em] flex items-center gap-2">
                    <span data-video-switcher-target="currentTime">00:00</span>
                    <span class="text-white/20">/</span>
                    <span data-video-switcher-target="duration">00:00</span>
                  </div>
                </div>

                <div class="flex items-center gap-4 md:gap-8">
                  <div class="relative">
                    <button type="button"
                      class="text-[10px] md:text-xs font-black text-white/70 hover:text-white border border-white/10 px-2.5 py-1 rounded-lg uppercase tracking-widest transition-colors"
                      data-video-switcher-target="speedButton"
                      data-action="video-switcher#toggleSpeedMenu">
                      1x
                    </button>
                    <div class="absolute bottom-full right-0 mb-2 hidden z-30 pointer-events-auto"
                         data-video-switcher-target="speedMenu"
                         data-action="mousedown->video-switcher#stopEvent click->video-switcher#stopEvent pointerdown->video-switcher#stopEvent">
                      <div class="bg-black/80 border border-white/10 rounded-lg p-2 flex flex-col gap-1 shadow-xl">
                        <button type="button" data-video-switcher-rate-param="0.25" data-action="video-switcher#setPlaybackRate"
                          class="text-[10px] md:text-xs font-black text-white/70 hover:text-white px-2 py-1 rounded-md hover:bg-white/10">0.25x</button>
                        <button type="button" data-video-switcher-rate-param="0.5" data-action="video-switcher#setPlaybackRate"
                          class="text-[10px] md:text-xs font-black text-white/70 hover:text-white px-2 py-1 rounded-md hover:bg-white/10">0.5x</button>
                        <button type="button" data-video-switcher-rate-param="1" data-action="video-switcher#setPlaybackRate"
                          class="text-[10px] md:text-xs font-black text-white/70 hover:text-white px-2 py-1 rounded-md hover:bg-white/10">1x</button>
                        <button type="button" data-video-switcher-rate-param="2" data-action="video-switcher#setPlaybackRate"
                          class="text-[10px] md:text-xs font-black text-white/70 hover:text-white px-2 py-1 rounded-md hover:bg-white/10">2x</button>
                        <button type="button" data-video-switcher-rate-param="3" data-action="video-switcher#setPlaybackRate"
                          class="text-[10px] md:text-xs font-black text-white/70 hover:text-white px-2 py-1 rounded-md hover:bg-white/10">3x</button>
                      </div>
                    </div>
                  </div>
                  <div class="flex items-center gap-3 group/volume">
                    <button type="button" data-action="video-switcher#toggleMute" class="text-white hover:text-accent-purple transition-colors">
                      <div data-video-switcher-target="volumeIcon">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
                      </div>
                      <div data-video-switcher-target="muteIcon" class="hidden">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4V5z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
                      </div>
                    </button>
                    <input type="range" min="0" max="1" step="0.01" value="1"
                      class="w-0 group-hover/volume:w-16 md:group-hover/volume:w-24 transition-all duration-300 opacity-0 group-hover/volume:opacity-100 h-1 bg-white/10 accent-accent-purple cursor-pointer"
                      data-video-switcher-target="volumeSlider"
                      data-action="input->video-switcher#onVolumeInput">
                  </div>

                  <button type="button" data-action="video-switcher#toggleFullscreen" class="text-white hover:text-accent-purple transition-all transform active:scale-90">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="card p-12 flex flex-col items-center justify-center border-dashed text-text-secondary">
      <span class="text-4xl mb-4">🔇</span>
      <p class="font-medium"><%= t("events.show.empty") %></p>
    </div>
  <% end %>

  <%= render "event_files" %>
  <%= render "event_admin" %>
</div>
