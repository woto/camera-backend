<div id="event-switcher-data" class="hidden"
     data-video-switcher-target="switcherData"
     data-video-switcher-captures-value="<%= @switcher_captures.to_json %>"
     data-video-switcher-current-id-value="<%= @base_capture&.id %>"
     data-video-switcher-prev-event-url-value="<%= @prev_event ? event_path(@prev_event, room: current_room_name) : "" %>"
     data-video-switcher-next-event-url-value="<%= @next_event ? event_path(@next_event, room: current_room_name) : "" %>"
     data-video-switcher-loading-text-value="<%= t("video_switcher.loading") %>"
     data-video-switcher-base-label-value="<%= t("video_switcher.base_label") %>"
     data-video-switcher-offset-label-value="<%= t("video_switcher.offset_label") %>"
     data-video-switcher-camera-label-value="<%= t("video_switcher.camera_label") %>"></div>
