<div id="event-files">
  <% if @captures.length > 0 %>
    <div class="mt-12 pt-10 border-t border-border-dim">
      <h2 class="text-xl font-bold text-white mb-6"><%= t("events.files.title") %></h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @captures.each do |capture| %>
          <% if capture.video.attached? %>
            <div class="bg-zinc-900/50 p-4 rounded-xl border border-border-dim flex items-center justify-between gap-4">
              <div>
                <div class="text-[11px] font-bold text-zinc-500 uppercase tracking-wider mb-1">
                  <%= t("events.files.capture", id: capture.id) %>
                </div>
                <div class="text-[10px] text-zinc-600">
                  <%= number_to_human_size(capture.video.byte_size) %>
                </div>
              </div>
              
              <%= link_to rails_blob_path(capture.video, disposition: "attachment"), class: "btn-secondary text-xs py-2 px-3 flex items-center gap-2" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <%= t("events.files.download") %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
