<% content_for :title, t("events.index.title") %>

<div id="events_page" class="max-w-none" data-controller="events-list" data-events-list-selected-value="<%= @selected_event_id %>">
  <div class="flex flex-wrap justify-between items-center gap-6 mb-8 md:mb-12">
    <div>
      <h1 class="text-2xl md:text-4xl font-black tracking-tight text-white m-0"><%= t("events.index.title") %></h1>
      <p class="text-text-secondary mt-1 text-sm md:text-base font-bold tracking-tight"><%= t("events.index.subtitle") %></p>
    </div>
    <div class="w-full sm:w-auto">
      <%= button_to t("events.index.save_recording"),
        recorder_trigger_path(room: current_room_name),
        class: "btn-primary w-full sm:w-auto",
        method: :post,
        data: { turbo_disable_with: t("events.index.saving") } %>
    </div>
  </div>

  <% if @events.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @events.each do |event| %>
        <div id="event-<%= event.id %>" data-event-id="<%= event.id %>" data-selected="<%= 'true' if @selected_event_id.to_s == event.id.to_s %>" class="card group cursor-pointer border-2 border-white/5 hover:border-accent-purple/30 relative <%= 'is-selected' if @selected_event_id.to_s == event.id.to_s %>">
          <%= link_to event_path(event), class: "block h-full" do %>
            <% frames = event_preview_frames(event) %>
            <% frame_urls = frames.map { |thumb| url_for(thumb) } %>
            <div class="relative aspect-[16/10] bg-zinc-950 overflow-hidden rounded-t-2xl"
                 data-controller="hover-preview"
                 data-hover-preview-frames-value="<%= frame_urls.to_json %>"
                 data-hover-preview-interval-value="320"
                 data-action="mouseenter->hover-preview#start mouseleave->hover-preview#stop">
              <div class="flex h-full items-center justify-center">
                <% if frame_urls.any? %>
                  <%= image_tag frame_urls.first, class: "h-full w-full object-cover", alt: "Thumbnail", data: { hover_preview_target: "image" } %>
                <% else %>
                  <div class="text-xs text-white/40"><%= t("events.index.no_preview") %></div>
                <% end %>
              </div>

              <!-- Glass Overlay Meta -->
              <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent opacity-90"></div>

              <div class="absolute top-4 left-4">
                <div class="bg-black/40 px-3 py-1.5 rounded-xl border border-white/10 text-[9px] font-black uppercase tracking-widest text-white/80">
                  <%= t("events.index.id") %>: <%= event.id %>
                </div>
              </div>

              <div class="absolute bottom-5 left-5 right-5 flex justify-between items-end">
                <div class="flex flex-col">
                  <div class="flex items-center gap-2 mb-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent-purple"></span>
                    <span class="text-[9px] font-black uppercase tracking-[0.2em] text-accent-purple"><%= t("events.index.record_label") %></span>
                  </div>
                  <span class="text-base font-black text-white leading-tight tracking-tight">
                    <% if event.captured_at %>
                      <span data-controller="local-time"
                            data-local-time-iso-value="<%= event.captured_at.utc.iso8601 %>"
                            data-local-time-locale-value="<%= I18n.locale %>"
                            data-local-time-format-value="long">
                        <%= l(event.captured_at.utc, format: :long) %>
                      </span>
                    <% end %>
                  </span>
                </div>
                <span class="badge <%= event.hidden? ? "badge-hidden" : "badge-open" %>">
                  <% if event.hidden? %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-label="<%= t("events.labels.hidden") %>" role="img">
                      <path d="M1 1l22 22"/>
                      <path d="M9.88 9.88a3 3 0 0 0 4.24 4.24"/>
                      <path d="M10.73 5.08A11 11 0 0 1 12 5c5 0 9.27 3.11 11 7-1.05 2.36-2.9 4.3-5.19 5.38"/>
                      <path d="M6.61 6.61C3.66 8.08 1.5 10.7 1 12c1.73 3.89 6 7 11 7 1.4 0 2.74-.24 3.99-.69"/>
                    </svg>
                  <% else %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-label="<%= t("events.labels.published") %>" role="img">
                      <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/>
                      <circle cx="12" cy="12" r="3"/>
                    </svg>
                  <% end %>
                </span>
              </div>
            </div>

            <div class="p-6 bg-white/[0.01] flex items-center justify-between border-t border-white/5">
              <div class="flex flex-col gap-1">
                <span class="text-[9px] text-text-secondary/40 font-black uppercase tracking-[0.2em]"><%= t("events.index.content") %></span>
                <span class="text-xs text-text-secondary font-black tracking-tight">
                  <%= t("events.captures_count", count: event.captures.size) %>
                </span>
              </div>
              <div class="w-10 h-10 rounded-2xl bg-white/5 flex items-center justify-center text-white/20 group-hover:text-white group-hover:bg-accent-purple">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="mt-12 md:mt-16 mb-20 flex justify-center">
      <div class="overflow-x-auto max-w-full pb-4 scrollbar-hide">
        <% raw_pagination = paginate @events, params: request.query_parameters.except("selected") %>
        <%= raw(strip_selected_from_pagination(raw_pagination)) %>
      </div>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-20 bg-card-bg rounded-2xl border border-dashed border-border-dim">
      <div class="text-4xl mb-4">📹</div>
      <p class="text-text-secondary font-medium"><%= t("events.index.empty") %></p>
    </div>
  <% end %>
</div>
